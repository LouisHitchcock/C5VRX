track:
    set 0..5 O0..O5,
    set 8..13 O8..O13,
    set 16..20 L0..L4,
    set 21..25 O26..O30,
    set 26..30 L0..L4,
    if L6 drop

emit:
    set 0..5 L8..L13,
    set 8..13 L8..L13,
    set 16..23 8..15,
    set 26..30 O26..O30,
    read 16,
    write 16,
    jmp track

drop:
    set 0..5 O0..O5,
    set 8..13 O0..O5,
    set 16..23 8..15,
    set 26..30 O26..O30,
    read 16,
    write 16,
    jmp reseed

reseed:
    set 0..5 O0..O5,
    set 8..13 O8..O13,
    set 16..20 L0..L4,
    set 21..25 O26..O30,
    set 26..30 L0..L4,
    if L6 drop

seed:
    set 0..5 O0..O5,
    set 8..13 O0..O5,
    set 16..23 8..15,
    set 26..30 O26..O30,
    read 16,
    write 16,
    jmp track

