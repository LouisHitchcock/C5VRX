controller_0:
    # L is the current raw endpoint's packed term. Keep minus in O0..O7.
    set 0..7 L0..L7,
    set 16..23 L,
    set 24..31 L8..L15,
    addctia

worker_0:
    # A[15:8] = (128 + (current-previous)) mod 256.
    set 0..5 A10..A15,
    set 8..13 A10..A15,
    set 16..23 8..15,
    set 24..31 O0..O7,
    read 16,
    write 16,
    ldctia

