# Phase8-HR arithmetic oracle only: unsafe large-delta wrap.
# Two bundles per pair, 20 MS/s unique DAC, duplicated at 40 MHz.
# Full-width Counter A allows next raw LUT address in its low byte while
# loading the retained previous term into its high byte.
cfg prefetch true
cfg eof_on downstream
cfg trailing_bytes 10
cfg lut_width_bits 16
lut 24816 39351 43176 44706 46236 46236 47001 47001 18695 18695 19460 19460 21246 22776 26601 40371 10025 24816 32466 37056 39351 40881 42411 43176 22776 23541 25071 26601 28896 33486 41136 55671 6200 16910 24816 30171 33231 36291 37821 39351 26601 28131 29661 32721 35781 41136 48786 59496 4670 12320 19205 24816 28641 31701 33996 35526 30426 31956 34251 37311 41136 46491 52611 61026 3140 10025 16145 20991 24816 27876 30171 32466 33486 35781 38076 41136 44961 49551 55671 61791 3140 8495 13085 17675 21756 24816 27111 29406 36546 38841 41136 44196 48021 52611 57201 62556 2375 6965 11555 15380 19205 22521 24816 27111 38841 41136 43431 46491 50316 54141 58731 63321 2375 6200 10025 13850 16910 19970 22521 24816 41136 43431 45726 48786 51846 55671 59496 63321 30681 26856 23031 18950 15890 12830 10535 8240 57456 55161 52866 49806 46746 42921 39096 35271 30681 26091 21501 17420 13595 10535 8240 5945 59751 57456 55161 52101 48276 44451 39861 35271 29916 24561 19715 15125 11300 8240 5945 3650 62046 59751 57456 54396 50571 45981 41391 36036 29916 23031 16655 12065 8240 5180 2885 590 65106 62811 60516 57456 53631 49041 42921 36801 28386 20480 13595 8240 4415 1355 64596 63066 2630 1100 64341 61281 57456 52101 45981 37566 26856 15890 8240 2885 65361 62301 60771 59241 6455 4925 3395 335 62811 57456 49806 39096 23031 8240 590 62301 59241 57711 56181 55416 10280 9515 7985 6455 3395 65106 57456 42921 9005 59241 55416 53886 53121 52356 51591 51591 14105 14105 13340 12575 11810 10280 6455 57456 24816 39351 43176 44706 46236 46236 47001 47001 18695 18695 19460 19460 21246 22776 26601 40371 10025 24816 32466 37056 39351 40881 42411 43176 22776 23541 25071 26601 28896 33486 41136 55671 6200 16910 24816 30171 33231 36291 37821 39351 26601 28131 29661 32721 35781 41136 48786 59496 4670 12320 19205 24816 28641 31701 33996 35526 30426 31956 34251 37311 41136 46491 52611 61026 3140 10025 16145 20991 24816 27876 30171 32466 33486 35781 38076 41136 44961 49551 55671 61791 3140 8495 13085 17675 21