prime_lookup:
    # First retained endpoint. No previous phase exists yet, so stage-1
    # Both middle-sample signs are direct input bits.
    set 16..23 8..15,
    set 24 7,
    set 25 3,
    read 16

prime_store:
    # Save the first actual Phase5, then issue stage 1 for the next pair.
    set 26..30 L8..L12,
    set 16..23 8..15,
    set 24 7,
    set 25 3,
    set 31 L,
    read 16

trajectory:
    # O26..O30 still holds previous actual Phase5. L contains stage-1 output
    # for the current pair. Save current actual phase for the next output while
    # addressing stage 2 with previous Phase5 + learned trajectory token.
    set 26..30 L8..L12,
    set 16..20 O26..O30,
    set 21 L6,
    set 22 L7,
    set 23 L13,
    set 24 L14,
    set 25 L15,
    set 31 L

emit:
    # Emit the stage-2 DAC code twice. At the same time preserve current phase
    # and issue stage 1 for the following [middle,current] raw-Q4 pair.
    set 0..5 L0..L5,
    set 6..7 L,
    set 8..13 L0..L5,
    set 14..15 L,
    set 26..30 O26..O30,
    set 16..23 8..15,
    set 24 7,
    set 25 3,
    set 31 L,
    read 16,
    write 16,
    jmp trajectory
