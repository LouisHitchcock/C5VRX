# Q2 adjacent-50: two-stage, two-bundle WBFM experiment.
#
# Input: packed Q4/I4 @ 40 MS/s (middle,current pair per 50 ns output).
# Output: 20 MS/s unique 6-bit CVBS duplicated [D,D] on the proven 40 MHz DAC.
#
# One physical 1024x16 LUT serves two learned stages:
#
# Stage 1 address (issued by emit):
#   bits 0..7 : current raw Q4/I4 byte
#   bit  8    : middle raw-I sign
#   bit  9    : middle raw-Q sign
# Stage 1 result:
#   L8..L12             : actual current Phase5
#   L6,L7,L13,L14,L15  : learned 5-bit trajectory token
#
# Stage 2 address (issued by trajectory):
#   bits 0..4 : previous actual Phase5
#   bits 5..9 : trajectory token
# Stage 2 result:
#   L0..L5 : final 6-bit CVBS code
#
# Training target is the clean exact-adjacent pair d0+d1 with NO second wrap.
# The learned raw-Q4 token carries amplitude/noise context, so clean signals do
# not have to sacrifice a Phase5 bit to expose the middle sample.
#
# After the two prime bundles, steady state is exactly:
#   trajectory -> emit -> trajectory -> emit ...
cfg prefetch true
cfg eof_on downstream
cfg trailing_bytes 0
cfg lut_width_bits 16
lut 9235 9869 10119 18177 18176 18432 18432 18432 6144 6272 63680 6528 63936 63999 64255 64704 640 9279 9599 9919 9919 10175 10175 10175 6463 6588 63990 6833 64234 64485 64735 65241 415 985 9243 9551 9561 9919 9919 9919 55999 6847 64255 64511 64511 64767 65023 65535 447 703 1023 9279 9599 9599 9599 9919 55999 7103 64511 64511 64759 65009 65258 65506 415 662 977 969 9218 9472 9536 9536 56256 64448 64448 64704 64960 64960 65216 65472 0 384 640 960 960 9216 9267 9472 56319 7348 48237 64756 65007 65264 65513 57570 39 417 666 980 972 9222 1216 9280 64512 7296 64512 48448 64960 65216 65472 0 0 384 680 704 960 1023 9279 9279 64575 64524 64895 32063 48766 65272 65524 45 12463 3880 3618 3612 27988 27981 27654 27648 46080 46080 37824 37824 37504 4672 37184 4096 20544 12096 20032 19776 3413 11328 27711 27711 46080 46143 46143 37887 4919 12863 12667 20597 20596 20336 20074 19810 19804 19540 11469 19398 46402 46080 46080 5056 13120 12864 12672 12416 20288 20041 19802 19776 19530 19583 19327 2943 46463 46463 13631 13439 13247 21311 21055 20862 20349 20090 19827 19563 19300 19293 19285 27217 46729 46403 13632 13632 13376 13120 12928 20800 20288 19776 19520 19264 19296 19071 19071 19071 5695 5823 13951 13695 13695 21567 13183 12735 20095 19538 19264 19056 19020 18781 18767 18769 5901 6022 14208 13824 13824 13568 13376 12928 27712 19008 18752 18752 18752 18496 18432 18432 55296 6336 6272 6016 14080 14080 5824 13440 17599 9983 10234 10226 10219 10470 10463 18457 30803 30799 39114 31044 39360 39360 39616 40128 17024 9408 9664 9920 9920 10176 10176 10239 14719 31103 31103 31359 39679 39935 40191 40639 8703 9215 9471 9727 9722 9970 9960 9954 31324 39446 39507 39818 31567 31884 32076 32656 8640 17087 9215 9471 9727 9727 9727 9791 23167 23423 31615 31615 31935 40319 32447 32703 8703 17151 9171 9215 9441 9711 9704 9701 56286 23385 31569 31820 32070 32065 32384 32640 8384 8640 8896 9152 9152 9408 1024 1408 56256 64512 15552 31808 32064 32320 32576 8406 8384 8689 8950 9215 9211 9465 9459 9260 64552 64543 23642 32084 32076 24200 16321 16512 8384 8640 8896 8896 8960 960 9216 9216 64512 64512 64832 64832 24192 15872 16128 8384 36864 28608 28352 28288 27998 28095 60470 27700 46124 46119 37857 37851 37396 37519 37194 36933 36864 28608 28288 28032 27968 27648 19648 27648 46080 46080 46080 37824 37824 37568 37248 36928 36927 28671 28351 28031 28031 27711 19711 19449 46451 46123 38117 37856 37785 37589 37262 36937 36611 28288 27968 27968 27648 27648 19392 19392 46400 21760 38336 38143 37887 37887 37567 37247 28671 28351 28031 27711 19455 19455 19455 19134 46778 38386 38379 38375 38111 37850 37525 37199 28617 27974 27651 19392 19392 19072 19072 19072 46720 38592 38592 38336 38336 38080 37760 37247 28288 27648 19432 19135 19135 18879 18879 18879 47100 38903 38896 38634 38627 38366 38104 37460 27663 19083 18822 18689 18688 18432 18432 18432 22528 30784 39104 38848 38848 38848 38592 38016 58431 59007 59327 59263 1919 2175 2175 2175 55423 55418 55412 55662 55659 55650 55962 64536 596 1104 1355 1606 1600 1856 1856 1856 55616 55680 55680 55936 55936 56256 64512 65152 383 895 1151 1407 1407 1663 1663 1663 55999 55999 55992 56308 56301 64551 64866 65436 347 595 847 1097 1349 1344 1344 1536 56000 56256 56256 56256 64512 64832 65152 7999 383 639 895 895 1151 1407 1407 1343 56319 56319 64319 64570 64881 64879 65189 7970 31 346 597 847 844 1094 1088 9536 56256 64704 64512 64576 64832 65152 65408 63 63 383 639 895 895 1151 34047 9279 64575 64575 64639 64895 64891 65207 65454 40 40 353 611 607 863 854 9236 9234 64512 31744 64842 64895 65181 65215 7999 63 4096 3840 28288 28288 3328 28031 27709 27711 46143 46143 37887 37887 37552 37557 37230 4138 45159 44896 44636 27927 44371 44108 3080 27651 46080 46080 46080 4864 21440 12992 61888 45120 45120 44864 44608 44352 3328 3072 3072 19392 46400 13504 13504 45888 45897 45632 45397 45154 44914 44649 44377 60703 52435 52428 2893 19401 13773 13763 46400 46144 45888 45888 45632 45376 44864 61120 60672 3072 60263 60287 52185 2623 46783 46